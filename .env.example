# Copy to .env for local development. .env is gitignored.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini

# Leave empty locally to skip the bearer check. Cloud Run always has it set.
CHAT_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000

# Optional: phone alerts for leads and unanswered questions.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Retrieval. Leave QDRANT_URL empty locally: the pipeline then uses a Qdrant store
# in data/qdrant/, and the chat API reads the newest build in data/builds/.
QDRANT_URL=
QDRANT_API_KEY=
